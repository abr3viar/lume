# Copie para .env.local e preencha. Nunca commite valores reais.
# O Lume tem três modos de IA, escolhidos nesta ordem:
#   1. Claude Code local (no seu PC, usa a sua conta do Claude, sem chave)
#   2. API da Anthropic (precisa de ANTHROPIC_API_KEY)
#   3. Sem IA: recomendador local do Lume e modelos base (padrão quando nada está configurado)

# Modo 1: rodando no seu PC com o Claude Code instalado e logado.
# LUME_AI_PROVIDER=claude-code
# LUME_CLAUDE_MODEL=sonnet
# LUME_CLAUDE_MODEL_FAST=haiku
# LUME_CLAUDE_BIN=claude

# Modo 2: chave da API da Anthropic (só no servidor; nunca use prefixo NEXT_PUBLIC).
ANTHROPIC_API_KEY=

# Modelos (opcionais; estes são os padrões).
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5

# Opcional: rate limit compartilhado entre instâncias (Upstash Redis REST).
# Sem estas variáveis, o limite é em memória e funciona como best-effort em serverless.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional: URL pública usada nos metadados e na imagem Open Graph.
NEXT_PUBLIC_SITE_URL=
